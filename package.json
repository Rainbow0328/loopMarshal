{
  "name": "loopmarshal",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop workspace for coding-agent collaboration through native CLI proxies, model agents, and MCP.",
  "license": "Apache-2.0",
  "author": "LoopMarshal Team",
  "homepage": "https://github.com/Rainbow0328/loopmarshal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rainbow0328/loopmarshal.git"
  },
  "bugs": {
    "url": "https://github.com/Rainbow0328/loopmarshal/issues"
  },
  "keywords": [
    "multi-agent",
    "agent-orchestration",
    "mcp",
    "ai-coding",
    "ai-collaboration",
    "llm",
    "claude-code",
    "cursor",
    "codex",
    "multi-llm",
    "agent-to-agent",
    "local-first",
    "knowledge-base",
    "ai-workflow"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*"
  ],
  "devDependencies": {
    "@loopmarshal/core": "workspace:*",
    "@loopmarshal/protocol": "workspace:*",
    "@loopmarshal/sdk": "workspace:*",
    "@loopmarshal/shared": "workspace:*",
    "@loopmarshal/store": "workspace:*",
    "@types/node": "^24.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && node scripts/desktop.mjs dev",
    "desktop:unpacked": "npm run desktop:prepare && node scripts/desktop.mjs unpacked",
    "desktop:dist": "npm run desktop:prepare && node scripts/desktop.mjs dist",
    "desktop:test": "pnpm --filter @loopmarshal/desktop test",
    "start": "pnpm run start:core",
    "dev": "pnpm run desktop:dev",
    "start:web": "cd apps/web && pnpm dev",
    "start:core": "cd apps/core && node dist/apps/core/src/index.js",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "clean": "node -e \"const{rmSync}=require('fs');for(const p of['apps/cli/dist','apps/core/dist','packages/protocol/dist','packages/shared/dist','packages/sdk/dist','packages/store/dist']){try{rmSync(p,{recursive:true,force:true})}catch{}}\"",
    "link:cli": "npm run build && npm link --workspace apps/cli",
    "pack:user": "npm run clean && npm run build && node scripts/pack-user-package.mjs && npm pack ./release/loopmarshal --json --cache .npm-cache --pack-destination ./release/loopmarshal",
    "unlink:cli": "npm unlink -g loopmarshal",
    "typecheck": "pnpm -r --workspace-concurrency=2 --if-present run typecheck",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:named": "npm run build && node scripts/smoke-named.mjs",
    "smoke:cli:loop": "npm run build && node scripts/smoke-cli-loop.mjs",
    "smoke:cli:wait-continuation": "npm run build && node scripts/smoke-cli-wait-continuation.mjs",
    "smoke:cli:wait-takeover": "npm run build && node scripts/smoke-cli-wait-takeover.mjs",
    "smoke:cli:message-handoff": "npm run build && node scripts/smoke-cli-message-handoff.mjs",
    "smoke:cli:host-execute": "npm run build && node scripts/smoke-cli-host-execute.mjs",
    "smoke:cli:session-idle": "npm run build && node scripts/smoke-cli-session-idle.mjs",
    "smoke:cli:knowledge": "npm run build && node scripts/smoke-cli-knowledge.mjs",
    "smoke:cli:knowledge-keeper": "npm run build && node scripts/smoke-cli-knowledge-keeper.mjs",
    "smoke:console:api": "npm run build && node scripts/smoke-console-api.mjs",
    "smoke:external": "npm run build && node scripts/smoke-external-control.mjs",
    "smoke:websocket:console-update": "npm run build && node scripts/smoke-websocket-console-update.mjs",
    "smoke:cli:attach-reset": "npm run build && node scripts/smoke-cli-attach-reset.mjs",
    "smoke:cli:batch-dispatch": "npm run build && node scripts/smoke-cli-batch-dispatch.mjs",
    "smoke:message:fail": "npm run build && node scripts/smoke-message-fail.mjs",
    "smoke:duplicate-agent-name": "npm run build && node scripts/smoke-duplicate-agent-name.mjs",
    "smoke:inbox:filters": "npm run build && node scripts/smoke-inbox-filters.mjs",
    "smoke:session:release": "npm run build && node scripts/smoke-session-release.mjs",
    "smoke:session:lifecycle": "npm run build && node scripts/smoke-session-lifecycle.mjs",
    "smoke:cli:stale-identity": "npm run build && node scripts/smoke-cli-stale-identity.mjs",
    "smoke:regression": "npm run build && node scripts/smoke-message-fail.mjs && node scripts/smoke-duplicate-agent-name.mjs && node scripts/smoke-inbox-filters.mjs",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "lint": "pnpm run format:check && pnpm run typecheck",
    "format": "prettier --write \"{apps,packages,adapters}/*/src/**/*.{ts,tsx,js,cjs,mjs,css}\" \"apps/*/*.{json,ts,cjs,js}\" \"packages/*/*.json\" \"scripts/**/*.{mjs,js}\" \"*.{json,yaml}\" \".prettierrc.json\"",
    "format:check": "prettier --check \"{apps,packages,adapters}/*/src/**/*.{ts,tsx,js,cjs,mjs,css}\" \"apps/*/*.{json,ts,cjs,js}\" \"packages/*/*.json\" \"scripts/**/*.{mjs,js}\" \"*.{json,yaml}\" \".prettierrc.json\""
  }
}
